{
  "name": "cubemind",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "面向 CFOP 竞速玩家的本地化 AI 解法分析助手",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "serve": "npm run build && npm run server",
    "dev": "npm run build && npm run serve",
    "server": "tsx watch src-backend/server.ts",
    "start": "npm run build && tsx src-backend/server.ts",
    "test": "node scripts/run-tests.mjs src-frontend/__tests__ src-backend/__tests__",
    "test:ble": "tsx --test src-frontend/__tests__/ble-packet-harness.test.ts src-frontend/__tests__/gan-v2-packet.test.ts src-frontend/__tests__/moyu-cube.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:ble": "npm run test:ble && npm run typecheck && npm run build",
    "verify": "npm run test && npm run typecheck && npm run build",
    "harness:verify": "npm run verify"
  },
  "dependencies": {
    "express": "^4.22.2",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^26.1.1",
    "esbuild": "^0.21.0",
    "tsx": "^4.22.5",
    "typescript": "^5.4.0"
  }
}
